{
  "name": "piet",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "piet": "bin/piet.mjs"
  },
  "type": "module",
  "scripts": {
    "test:cli": "node --test bin/piet.test.mjs",
    "predev": "pnpm --filter @piet/protocol build",
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:web": "pnpm --filter @piet/protocol build && pnpm --filter @piet/web run dev",
    "dev:backend": "pnpm --filter @piet/protocol build && pnpm --filter @piet/backend run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm test:cli && pnpm --filter @piet/protocol build && pnpm -r --if-present run test",
    "test:browser": "pnpm --filter @piet/protocol build && pnpm --filter @piet/web test:browser",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.94.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=12.21.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
